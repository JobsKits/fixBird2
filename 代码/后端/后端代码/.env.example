# 啄木鸟维修平台配置样例：只声明支持的字段，不包含真实地址或凭据。
# Go和部署入口不会自动加载本文件；在当前Shell/PowerShell或部署环境显式传入。
# 空值沿用实际入口默认值；公共SDK、依赖缓存和Runtime均从目标机器环境解析。

# 后端读取：静态资料与项目运行数据分别定位。
WB_PROJECT_ROOT=
WB_RUNTIME_DIR=
WB_ADDR=127.0.0.1:8098
WB_DATA_DIR=
WB_KEY_FILE=
WB_WEB_DIR=
WB_ADMIN_DIR=
WB_ADMIN_FLUTTER_DIR=
WB_CLIENT_FLUTTER_DIR=
WB_ADMIN_CONTRACT_DIR=

# 数据库与备份：只有显式配置才启用；保留原数据匹配密钥。
WB_TIDB_DSN=
WB_REQUIRE_DB_TLS=
WB_BACKUP_DIR=
WB_BACKUP_INTERVAL_MINUTES=1440

# 部署入口读取：只作用于当前进程及其子进程，不修改系统全局设置。
WB_ENV_ROOT=
GO_BIN=
WB_FZF_BIN=
WB_CLOUDFLARED_BIN=
WB_TUNNEL_ALLOWED_MAIL=
WB_TUNNEL_START_TIMEOUT=45
