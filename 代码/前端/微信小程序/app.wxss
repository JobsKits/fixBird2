/* Jobs · 原生小程序共享视觉角色，外观与界面设置保持同一来源。 */
page { --canvas:#F3F6F4;--surface:#FFFFFF;--ink:#152820;--muted:#53675D;--line:#D8E3DC;--brand:#0F5144;--tint:#E9F2ED;background:var(--canvas);color:var(--ink);font-size:32rpx; }
.shell { padding:28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));max-width:960px;margin:auto;box-sizing:border-box;color:var(--ink); }
.brand,.row,.nav { display:flex;align-items:center;gap:16rpx; }
.brand { margin:8rpx 0 32rpx; }.logo { width:88rpx;height:88rpx;flex-shrink:0; }.title { font-size:40rpx;font-weight:700;line-height:1.4;letter-spacing:-.5rpx; }
.card,.empty { background:var(--surface);border-radius:32rpx;padding:32rpx;margin:24rpx 0; }.heading { font-size:36rpx;font-weight:650;line-height:1.5;margin-bottom:12rpx; }.muted { color:var(--muted);font-size:28rpx;line-height:1.7; }.label { display:block;margin:28rpx 0 12rpx;font-size:28rpx;font-weight:600; }
input,textarea,.pick { box-sizing:border-box;width:100%;background:var(--canvas);color:var(--ink);border:2rpx solid var(--line);border-radius:20rpx;padding:20rpx 24rpx;font-size:32rpx;line-height:1.5; } input { height:104rpx; } textarea { min-height:160rpx; }.pick { margin:16rpx 0;color:var(--brand); }
button { margin:12rpx 0;background:var(--tint);color:var(--brand);min-height:96rpx;line-height:1.5;padding:24rpx 28rpx;font-size:30rpx;font-weight:600;border-radius:20rpx;white-space:normal;overflow-wrap:anywhere; } button::after { border:none; }.primary { background:#0F5144;color:#FFFFFF; } button[disabled],.primary[disabled] { background:var(--line);color:var(--muted); } button[size=mini] { min-height:88rpx;padding:20rpx 24rpx; }
.nav { position:relative;background:var(--surface);border-radius:24rpx;padding:8rpx;margin:24rpx 0;align-items:stretch;gap:8rpx; }.nav button { flex:1;min-width:0;margin:0;background:transparent;color:var(--muted);padding:20rpx 8rpx; }.nav button.active { background:var(--tint);color:var(--brand); }
.grow { flex:1;min-width:0; }.row { flex-wrap:wrap; }.stats { display:flex;gap:20rpx; }.stats .card { flex:1;min-width:0;margin-bottom:0; }.number { font-size:48rpx;font-weight:700;line-height:1.3;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;margin-top:12rpx; }.badge { font-size:24rpx;background:var(--tint);color:var(--brand);border-radius:12rpx;padding:8rpx 12rpx; }.link { color:var(--brand);font-weight:600; }
.notice { display:block;background:var(--tint);color:var(--muted);padding:24rpx;border-radius:20rpx;font-size:28rpx;line-height:1.6; }.notice.online { color:var(--brand); }.fact { padding:24rpx 0;border-bottom:2rpx solid var(--line); }.fact:last-child { border-bottom:none; }.fact text { display:block;overflow-wrap:anywhere;line-height:1.65; }.selectable { user-select:text; }.empty { text-align:center;line-height:1.8; }.empty .muted { display:block; }.compact { padding:24rpx;margin:16rpx 0;background:var(--canvas); }.page { justify-content:space-between;font-size:28rpx; }.action-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx; }.signature { display:block;width:100%;height:180px;background:#FFFFFF;border:2rpx solid var(--line); }.field { margin-bottom:24rpx; }.settings-button { width:96rpx;height:96rpx;min-height:96rpx;padding:0;line-height:96rpx;font-size:40rpx;margin-left:0; }.order-card .heading { margin-bottom:0; }.order-card .order-task { display:block;margin:20rpx 0; }.order-footer { border-top:2rpx solid var(--line);padding-top:24rpx;margin-top:24rpx; }
.theme-dark { --canvas:#101C18;--surface:#192A22;--ink:#EFF6F1;--muted:#B5C7BB;--line:#3B5345;--brand:#8CCBA8;--tint:#233E2F;background:var(--canvas); }
.theme-light { --canvas:#F3F6F4;--surface:#FFFFFF;--ink:#152820;--muted:#53675D;--line:#D8E3DC;--brand:#0F5144;--tint:#E9F2ED;background:var(--canvas); }
@media (prefers-color-scheme:dark) { page { --canvas:#101C18;--surface:#192A22;--ink:#EFF6F1;--muted:#B5C7BB;--line:#3B5345;--brand:#8CCBA8;--tint:#233E2F; } }
@media (min-width:768px) { .shell { padding-top:48rpx; }.card,.empty { padding:40rpx; }.action-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
