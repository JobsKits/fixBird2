{
  "description": "啄木鸟维修平台 V3.8 微信原生小程序",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "repair-miniprogram",
  "setting": {
    "es6": true,
    "minified": true,
    "urlCheck": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "folder",
        "value": ".codegraph"
      },
      {
        "type": "folder",
        "value": "代码地图"
      },
      {
        "type": "file",
        "value": "codegraph.json"
      }
    ]
  }
}
