.shell { padding:28rpx 24rpx calc(36rpx + env(safe-area-inset-bottom)); max-width:960px; margin:auto; }
.brand,.row,.nav { display:flex; align-items:center; gap:16rpx; }
.brand { margin:12rpx 0 28rpx; }.logo { width:88rpx; height:88rpx; border-radius:20rpx; background:white; }.title{font-size:40rpx;font-weight:700;}
.card,.empty { background:white;border:1rpx solid #DBE4E7;border-radius:24rpx;padding:28rpx;margin:20rpx 0; }.heading{font-size:32rpx;font-weight:650;margin-bottom:14rpx;}.muted{color:#52636B;font-size:26rpx;line-height:1.7;}.label{display:block;margin:28rpx 0 12rpx;font-size:28rpx;font-weight:600;}
input,textarea,.pick { box-sizing:border-box;width:100%;background:#F4F7F8;border:1rpx solid #DBE4E7;border-radius:14rpx;padding:20rpx;font-size:28rpx; } input{height:88rpx;} textarea{min-height:140rpx;}.pick{margin:14rpx 0;color:#0F766E;}
button{margin:14rpx 0;background:#EAF2F2;color:#155E57;min-height:80rpx;line-height:1.5;padding:20rpx 22rpx;}.primary{background:#0F766E;color:white;}.primary[disabled]{background:#C5D4D2;color:#52636B;}button[size=mini]{min-height:64rpx;padding:12rpx 18rpx;}.nav{position:relative;justify-content:space-between;}.nav button{flex:1;}
.grow{flex:1;min-width:0;}.row{flex-wrap:wrap;}.stats{display:flex;gap:20rpx;}.stats .card{flex:1;min-width:0;}.number{font-size:42rpx;font-weight:700;overflow-wrap:anywhere;margin-top:12rpx;}.badge{font-size:24rpx;background:#E4F3EF;color:#0F766E;border-radius:12rpx;padding:10rpx;}.link{color:#0F766E;}.notice{display:block;background:#FFF2D5;color:#694F13;padding:22rpx;border-radius:14rpx;font-size:26rpx;line-height:1.6;}.notice.online{background:#E3F4ED;color:#16664C;}
.fact{padding:20rpx 0;border-bottom:1rpx solid #E9EFEF;}.fact text{display:block;word-break:break-all;line-height:1.65;}.selectable{user-select:text;}.empty{text-align:center;line-height:1.8;}.empty .muted{display:block;}.compact{padding:20rpx;margin:12rpx 0;border:none;background:#F4F7F8;}.page{justify-content:space-between;font-size:26rpx;}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;}.signature{display:block;width:100%;height:180px;background:white;border:2rpx solid #9BAEB4;}.field{margin-bottom:18rpx;}
