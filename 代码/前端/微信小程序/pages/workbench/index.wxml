<view class="shell">
  <view class="brand"><image class="logo" src="/assets/RepairLogo.png" mode="aspectFit"/><view><view class="title">啄木鸟维修</view><text class="muted">工单协同 · 微信小程序</text></view></view>
  <view class="notice {{source === 'server' ? 'online' : ''}}">{{message}}</view>
  <view wx:if="{{pending}}" class="notice">存在结果未确认的提交。请核对服务端记录，或按原内容与请求键重试。<button bindtap="retryPending" disabled="{{busy}}">按原内容重试</button><button bindtap="acknowledgePending" disabled="{{busy}}">已核对，结束重试</button></view>
  <view wx:if="{{loggedIn}}" class="nav">
    <button bindtap="nav" data-screen="orders">工单</button><button bindtap="nav" data-screen="inventory">库存借还</button><button bindtap="nav" data-screen="settings">我的</button>
  </view>
  <view wx:if="{{screen === 'login'}}" class="card">
    <view class="heading">登录维修工作台</view><text class="muted">使用现有 V3.8 账号；真实微信身份尚未接入。</text>
    <text class="label">账号</text><input value="{{username}}" bindinput="input" data-key="username" placeholder="请输入账号"/>
    <text class="label">密码</text><input value="{{password}}" password bindinput="input" data-key="password" placeholder="请输入密码"/>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">登录并进入</button>
    <picker range="{{roles}}" range-key="label" bindchange="role"><view class="pick">选择合成示例角色 ›</view></picker>
    <text class="muted selectable" selectable="true" selectable="true">示例密码：Demo-Repair-2026!；合成资料仅供演示，网络与响应失败时使用隔离样例。</text>
    <button bindtap="nav" data-screen="settings">服务器与超时设置</button>
  </view>
  <block wx:if="{{screen === 'orders'}}">
    <view class="stats"><view class="card"><text class="muted">进行中</text><view class="number">{{openCount}}</view></view><view class="card"><text class="muted">待收（元）</text><view class="number">{{remaining}}</view></view></view>
    <view class="card"><view class="row"><input class="grow" value="{{q}}" bindinput="input" data-key="q" placeholder="工单号、客户、设备" confirm-type="search" bindconfirm="search"/><button size="mini" bindtap="search" disabled="{{busy}}">搜索</button></view>
      <picker range="{{states}}" range-key="label" value="{{stateIndex}}" bindchange="state"><view class="pick">{{states[stateIndex].label}} ›</view></picker>
      <view class="row"><button class="primary grow" bindtap="create" disabled="{{!writable || busy}}">新建工单</button><button bindtap="reload" disabled="{{busy}}">重新加载</button></view>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}">
      <view class="row"><text class="heading grow">{{item.device}}</text><text class="badge">{{item.stateLabel}}</text></view><text class="muted selectable">{{item.number}}</text><view>{{item.customer}} · {{item.project}}</view><view class="muted">{{item.summary.nextTask}}</view><view class="row"><text class="grow">待收 ¥{{item.remaining}}</text><text class="link">查看详情与办理 ›</text></view>
    </view>
    <view wx:if="{{!orders.length}}" class="empty"><view class="heading">暂时没有工单</view><text class="muted">可以调整关键词、阶段或重新加载。</text><button bindtap="reload" disabled="{{busy}}">重新加载</button></view>
    <view wx:if="{{pagination}}" class="row page"><button size="mini" data-step="-1" bindtap="turn" disabled="{{page <= 1 || busy}}">上一页</button><text>第 {{page}} 页 · 共 {{pagination.total}} 条</text><button size="mini" data-step="1" bindtap="turn" disabled="{{page >= pagination.totalPages || busy}}">下一页</button></view>
  </block>
  <block wx:if="{{screen === 'detail'}}">
    <button bindtap="nav" data-screen="orders">返回工单</button>
    <view wx:if="{{!detail}}" class="empty"><view class="heading">{{busy ? '正在读取完整工单' : '详情暂不可用'}}</view><text class="muted">{{error || '请稍候或重新加载工单详情。'}}</text><button bindtap="retryDetail" disabled="{{busy}}">重新加载</button></view>
    <block wx:else>
      <view wx:for="{{sections}}" wx:for-item="section" wx:key="title" class="card"><view class="heading">{{section.title}}</view>
        <view wx:for="{{section.rows}}" wx:key="key" class="fact"><text class="muted">{{item.label}}</text><text class="selectable" selectable="true" selectable="true">{{item.value}}</text></view>
        <view wx:if="{{!section.rows.length}}" class="empty compact"><text class="muted">暂无{{section.title}}</text><button size="mini" bindtap="retryDetail" disabled="{{busy}}">重新加载</button></view>
      </view>
      <view class="card"><view class="heading">证据与原件</view><view wx:for="{{evidence}}" wx:key="id" class="fact"><text class="selectable">{{item.name}} · {{item.id}}</text><text>{{item.text}}</text><button wx:if="{{!item.deleted}}" size="mini" data-id="{{item.id}}" bindtap="download" disabled="{{busy}}">读取授权原件</button></view><view wx:if="{{!evidence.length}}" class="empty compact"><text>暂无证据</text><button size="mini" bindtap="retryDetail">重新加载</button></view></view>
      <view class="card"><view class="heading">当前可办理</view><text class="muted">办理前核对当前版本；权限、阶段和业务规则由服务端校验。</text><view class="action-grid"><button wx:for="{{actions}}" wx:key="type" data-type="{{item.type}}" bindtap="action" disabled="{{!writable || busy}}">{{item.label}}</button></view><view wx:if="{{!actions.length}}" class="empty compact"><text>当前没有可办理动作</text><button size="mini" bindtap="retryDetail">重新加载</button></view></view>
    </block>
  </block>
  <block wx:if="{{screen === 'inventory'}}">
    <view class="row"><button class="primary grow" data-kind="loan" bindtap="inventoryForm" disabled="{{!writable || busy}}">登记借用</button><button class="primary grow" data-kind="purchase" bindtap="inventoryForm" disabled="{{!writable || busy}}">登记采购</button><button bindtap="reload" disabled="{{busy}}">重载</button></view>
    <view class="card"><view class="heading">库存配件</view><view wx:for="{{parts}}" wx:key="id" class="fact"><text class="selectable">{{item.name}} · {{item.id}}</text><text>可用 {{item.available}} · 待检 {{item.quarantine}}</text></view><view wx:if="{{!parts.length}}" class="empty compact"><text>暂无配件</text><button size="mini" bindtap="reload">重新加载</button></view></view>
    <view class="card"><view class="heading">借还记录</view><view wx:for="{{loans}}" wx:key="id" class="fact"><text class="selectable">{{item.id}} · {{item.partName}} · {{item.borrowerId}}</text><text>待归还 {{item.outstanding}} · {{item.dueAt}}</text><view class="row"><button size="mini" bindtap="inventoryForm" data-kind="return" data-id="{{item.id}}" disabled="{{!writable || busy}}">归还</button><button size="mini" bindtap="inventoryForm" data-kind="consume" data-id="{{item.id}}" disabled="{{!writable || busy}}">耗用</button><button size="mini" bindtap="inventoryForm" data-kind="dispose" data-id="{{item.id}}" disabled="{{!writable || busy}}">处置</button><button size="mini" bindtap="inventoryForm" data-kind="transfer" data-id="{{item.id}}" disabled="{{!writable || busy}}">转跟踪</button></view></view><view wx:if="{{!loans.length}}" class="empty compact"><text>暂无借还记录</text><button size="mini" bindtap="reload">重新加载</button></view></view>
    <view class="card"><view class="heading">采购记录</view><view wx:for="{{purchases}}" wx:key="id" class="fact"><text class="selectable">{{item.id}} · {{item.supplier}} · {{item.partId}}</text><text>采购 {{item.quantity}} · 已收 {{item.received}}</text><button size="mini" bindtap="inventoryForm" data-kind="receivePurchase" data-id="{{item.id}}" disabled="{{!writable || busy}}">登记收货</button></view><view wx:if="{{!purchases.length}}" class="empty compact"><text>暂无采购记录</text><button size="mini" bindtap="reload">重新加载</button></view></view>
  </block>
  <view wx:if="{{screen === 'form'}}" class="card">
    <view class="heading">{{formTitle}}</view><text wx:if="{{source !== 'server'}}" class="notice">当前是独立合成演示，请勿录入真实客户、签名或文件。</text>
    <view wx:for="{{fields}}" wx:key="key" class="field"><text class="label">{{item.label}}{{item.required ? ' *' : ''}}</text>
      <picker wx:if="{{item.type === 'select'}}" range="{{item.options}}" range-key="label" value="{{item.index}}" disabled="{{busy || pending}}" bindchange="field" data-key="{{item.key}}"><view class="pick">{{item.options[item.index].label}} ›</view></picker>
      <switch wx:elif="{{item.type === 'bool'}}" checked="{{item.value}}" bindchange="field" data-key="{{item.key}}" color="#0F766E"/>
      <textarea wx:elif="{{item.type === 'textarea'}}" value="{{item.value}}" disabled="{{busy || pending}}" bindinput="field" data-key="{{item.key}}" maxlength="10000" auto-height placeholder="请输入内容"/>
      <view wx:elif="{{item.type === 'signature'}}"><canvas canvas-id="signature" id="signature" class="signature" disable-scroll bindtouchstart="signatureStart" bindtouchmove="signatureMove" bindtouchend="signatureEnd"/><button size="mini" bindtap="clearSignature">清空签名</button></view>
      <view wx:elif="{{item.type === 'file'}}"><button bindtap="chooseFile">从微信会话选择文件（≤6MB）</button><text>{{fileLabel}}</text></view>
      <input wx:else value="{{item.value}}" bindinput="field" data-key="{{item.key}}" type="{{item.type === 'int' ? 'number' : item.type === 'money' ? 'digit' : 'text'}}" placeholder="{{item.type === 'datetime' ? '2026-11-03T10:00:00+08:00' : '请输入内容'}}"/>
    </view>
    <text wx:if="{{error}}" class="notice">{{error}}</text><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">确认提交</button><button bindtap="cancelForm" disabled="{{busy}}">取消</button>
  </view>
  <view wx:if="{{screen === 'settings'}}" class="card"><view class="heading">服务器与我的</view><text>{{actor.displayName || actor.name || username}}</text><text class="label">服务器根地址</text><input value="{{base}}" bindinput="input" data-key="base" placeholder="https://维修服务域名"/><text class="label">超时（500—10000 毫秒）</text><input type="number" value="{{timeout}}" bindinput="input" data-key="timeout"/><button bindtap="saveConfig" disabled="{{busy}}">保存并重新登录</button>
    <text class="muted">保存配置会清除当前身份资料。电脑工具本地调试可用回环 HTTP；手机与发布须使用有效 HTTPS 和小程序合法域名。微信登录、微信支付、订阅消息及认证电子签尚未接入。</text><button wx:if="{{loggedIn}}" bindtap="logout" disabled="{{busy}}">退出并清除会话</button><button wx:else bindtap="nav" data-screen="login">返回登录</button>
  </view>
</view>
