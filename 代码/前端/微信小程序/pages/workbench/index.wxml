<view class="shell theme-{{appearance || 'system'}}">
  <view class="brand"><image class="logo" src="/assets/RepairLogo.png" mode="aspectFit"/><view><view class="title">{{ui['啄木鸟维修'] || '啄木鸟维修'}}</view><text class="muted">{{ui['工单协同 · 微信小程序'] || '工单协同 · 微信小程序'}}</text></view></view>
  <view class="notice {{source === 'server' ? 'online' : ''}}">{{message}}</view>
  <view wx:if="{{pending}}" class="notice">{{ui['存在结果未确认的提交。请核对服务端记录，或按原内容与请求键重试。'] || '存在结果未确认的提交。请核对服务端记录，或按原内容与请求键重试。'}}<button bindtap="retryPending" disabled="{{busy}}">{{ui['按原内容重试'] || '按原内容重试'}}</button><button bindtap="acknowledgePending" disabled="{{busy}}">{{ui['已核对，结束重试'] || '已核对，结束重试'}}</button></view>
  <view wx:if="{{loggedIn}}" class="nav">
    <button class="{{screen === 'orders' ? 'active' : ''}}" bindtap="nav" data-screen="orders">{{ui['工单'] || '工单'}}</button><button class="{{screen === 'inventory' ? 'active' : ''}}" bindtap="nav" data-screen="inventory">{{ui['库存借还'] || '库存借还'}}</button><button class="{{screen === 'settings' ? 'active' : ''}}" bindtap="nav" data-screen="settings">{{ui['我的'] || '我的'}}</button>
  </view>
  <view wx:if="{{screen === 'login'}}" class="card">
    <view class="heading">{{ui['登录维修工作台'] || '登录维修工作台'}}</view><text class="muted">{{ui['使用现有 V3.8 账号；真实微信身份尚未接入。'] || '使用现有 V3.8 账号；真实微信身份尚未接入。'}}</text>
    <text class="label">{{ui['账号'] || '账号'}}</text><input value="{{username}}" bindinput="input" data-key="username" placeholder="{{ui['请输入账号'] || '请输入账号'}}"/>
    <text class="label">{{ui['密码'] || '密码'}}</text><input value="{{password}}" password bindinput="input" data-key="password" placeholder="{{ui['请输入密码'] || '请输入密码'}}"/>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">{{ui['登录并进入'] || '登录并进入'}}</button>
    <picker range="{{roles}}" range-key="label" bindchange="role"><view class="pick">{{ui['选择合成示例角色 ›'] || '选择合成示例角色 ›'}}</view></picker>
    <text class="muted selectable" selectable="true">{{ui['示例密码：Demo-Repair-2026!；合成资料仅供演示，网络与响应失败时使用隔离样例。'] || '示例密码：Demo-Repair-2026!；合成资料仅供演示，网络与响应失败时使用隔离样例。'}}</text>
    <button class="settings-button" bindtap="nav" data-screen="settings" aria-label="{{ui['服务器与超时设置'] || '服务器与超时设置'}}">⚙</button>
  </view>
  <block wx:if="{{screen === 'orders'}}">
    <view class="stats"><view class="card"><text class="muted">{{ui['进行中'] || '进行中'}}</text><view class="number">{{openCount}}</view></view><view class="card"><text class="muted">{{ui['待收（元）'] || '待收（元）'}}</text><view class="number">{{remaining}}</view></view></view>
    <view class="card"><view class="row"><input class="grow" value="{{q}}" bindinput="input" data-key="q" placeholder="{{ui['工单号、客户、设备'] || '工单号、客户、设备'}}" confirm-type="search" bindconfirm="search"/><button size="mini" bindtap="search" disabled="{{busy}}">{{ui['搜索'] || '搜索'}}</button></view>
      <picker range="{{states}}" range-key="label" value="{{stateIndex}}" bindchange="state"><view class="pick">{{states[stateIndex].label}} ›</view></picker>
      <view class="row"><button class="primary grow" bindtap="create" disabled="{{!writable || busy}}">{{ui['新建工单'] || '新建工单'}}</button><button bindtap="reload" disabled="{{busy}}">{{ui['重新加载'] || '重新加载'}}</button></view>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="card order-card" bindtap="open" data-id="{{item.id}}">
      <view class="row"><text class="heading grow">{{item.device}}</text><text class="badge">{{item.stateLabel}}</text></view><text class="muted selectable">{{item.number}}</text><view>{{item.customer}} · {{item.project}}</view><view class="muted order-task">{{item.summary.nextTask}}</view><view class="row order-footer"><text class="grow">{{ui['待收'] || '待收'}} ¥{{item.remaining}}</text><text class="link">{{ui['查看详情与办理 ›'] || '查看详情与办理 ›'}}</text></view>
    </view>
    <view wx:if="{{!orders.length}}" class="empty"><view class="heading">{{ui['暂时没有工单'] || '暂时没有工单'}}</view><text class="muted">{{ui['可以调整关键词、阶段或重新加载。'] || '可以调整关键词、阶段或重新加载。'}}</text><button bindtap="reload" disabled="{{busy}}">{{ui['重新加载'] || '重新加载'}}</button></view>
    <view wx:if="{{pagination}}" class="row page"><button size="mini" data-step="-1" bindtap="turn" disabled="{{page <= 1 || busy}}">{{ui['上一页'] || '上一页'}}</button><text>{{ui['第'] || '第'}} {{page}} {{ui['页'] || '页'}} · {{ui['共'] || '共'}} {{pagination.total}} {{ui[' 条'] || ' 条'}}</text><button size="mini" data-step="1" bindtap="turn" disabled="{{page >= pagination.totalPages || busy}}">{{ui['下一页'] || '下一页'}}</button></view>
  </block>
  <block wx:if="{{screen === 'detail'}}">
    <button bindtap="nav" data-screen="orders">{{ui['返回工单'] || '返回工单'}}</button>
    <view wx:if="{{!detail}}" class="empty"><view class="heading">{{busy ? (ui['正在读取完整工单'] || '正在读取完整工单') : (ui['详情暂不可用'] || '详情暂不可用')}}</view><text class="muted">{{error || ui['请稍候或重新加载工单详情。'] || '请稍候或重新加载工单详情。'}}</text><button bindtap="retryDetail" disabled="{{busy}}">{{ui['重新加载'] || '重新加载'}}</button></view>
    <block wx:else>
      <view wx:for="{{sections}}" wx:for-item="section" wx:key="title" class="card"><view class="heading">{{section.title}}</view>
        <view wx:for="{{section.rows}}" wx:key="key" class="fact"><text class="muted">{{item.label}}</text><text class="selectable" selectable="true">{{item.value}}</text></view>
        <view wx:if="{{!section.rows.length}}" class="empty compact"><text class="muted">{{section.emptyTitle}}</text><button size="mini" bindtap="retryDetail" disabled="{{busy}}">{{ui['重新加载'] || '重新加载'}}</button></view>
      </view>
      <view class="card"><view class="heading">{{ui['证据与原件'] || '证据与原件'}}</view><view wx:for="{{evidence}}" wx:key="id" class="fact"><text class="selectable">{{item.name}} · {{item.id}}</text><text>{{item.text}}</text><button wx:if="{{!item.deleted}}" size="mini" data-id="{{item.id}}" bindtap="download" disabled="{{busy}}">{{ui['读取授权原件'] || '读取授权原件'}}</button></view><view wx:if="{{!evidence.length}}" class="empty compact"><text>{{ui['暂无证据'] || '暂无证据'}}</text><button size="mini" bindtap="retryDetail">{{ui['重新加载'] || '重新加载'}}</button></view></view>
      <view class="card"><view class="heading">{{ui['当前可办理'] || '当前可办理'}}</view><text class="muted">{{ui['办理前核对当前版本；权限、阶段和业务规则由服务端校验。'] || '办理前核对当前版本；权限、阶段和业务规则由服务端校验。'}}</text><view class="action-grid"><button wx:for="{{actions}}" wx:key="type" data-type="{{item.type}}" bindtap="action" disabled="{{!writable || busy}}">{{item.label}}</button></view><view wx:if="{{!actions.length}}" class="empty compact"><text>{{ui['当前没有可办理动作'] || '当前没有可办理动作'}}</text><button size="mini" bindtap="retryDetail">{{ui['重新加载'] || '重新加载'}}</button></view></view>
    </block>
  </block>
  <block wx:if="{{screen === 'inventory'}}">
    <view class="row"><button class="primary grow" data-kind="loan" bindtap="inventoryForm" disabled="{{!writable || busy}}">{{ui['登记借用'] || '登记借用'}}</button><button class="primary grow" data-kind="purchase" bindtap="inventoryForm" disabled="{{!writable || busy}}">{{ui['登记采购'] || '登记采购'}}</button><button bindtap="reload" disabled="{{busy}}">{{ui['重载'] || '重载'}}</button></view>
    <view class="card"><view class="heading">{{ui['库存配件'] || '库存配件'}}</view><view wx:for="{{parts}}" wx:key="id" class="fact"><text class="selectable">{{item.name}} · {{item.id}}</text><text>{{ui['可用'] || '可用'}} {{item.available}} · {{ui['待检'] || '待检'}} {{item.quarantine}}</text></view><view wx:if="{{!parts.length}}" class="empty compact"><text>{{ui['暂无配件'] || '暂无配件'}}</text><button size="mini" bindtap="reload">{{ui['重新加载'] || '重新加载'}}</button></view></view>
    <view class="card"><view class="heading">{{ui['借还记录'] || '借还记录'}}</view><view wx:for="{{loans}}" wx:key="id" class="fact"><text class="selectable">{{item.id}} · {{item.partName}} · {{item.borrowerId}}</text><text>{{ui['待归还'] || '待归还'}} {{item.outstanding}} · {{item.dueAt}}</text><view class="row"><button size="mini" bindtap="inventoryForm" data-kind="return" data-id="{{item.id}}" disabled="{{!writable || busy}}">{{ui['归还'] || '归还'}}</button><button size="mini" bindtap="inventoryForm" data-kind="consume" data-id="{{item.id}}" disabled="{{!writable || busy}}">{{ui['耗用'] || '耗用'}}</button><button size="mini" bindtap="inventoryForm" data-kind="dispose" data-id="{{item.id}}" disabled="{{!writable || busy}}">{{ui['处置'] || '处置'}}</button><button size="mini" bindtap="inventoryForm" data-kind="transfer" data-id="{{item.id}}" disabled="{{!writable || busy}}">{{ui['转跟踪'] || '转跟踪'}}</button></view></view><view wx:if="{{!loans.length}}" class="empty compact"><text>{{ui['暂无借还记录'] || '暂无借还记录'}}</text><button size="mini" bindtap="reload">{{ui['重新加载'] || '重新加载'}}</button></view></view>
    <view class="card"><view class="heading">{{ui['采购记录'] || '采购记录'}}</view><view wx:for="{{purchases}}" wx:key="id" class="fact"><text class="selectable">{{item.id}} · {{item.supplier}} · {{item.partId}}</text><text>{{ui['采购'] || '采购'}} {{item.quantity}} · {{ui['已收'] || '已收'}} {{item.received}}</text><button size="mini" bindtap="inventoryForm" data-kind="receivePurchase" data-id="{{item.id}}" disabled="{{!writable || busy}}">{{ui['登记收货'] || '登记收货'}}</button></view><view wx:if="{{!purchases.length}}" class="empty compact"><text>{{ui['暂无采购记录'] || '暂无采购记录'}}</text><button size="mini" bindtap="reload">{{ui['重新加载'] || '重新加载'}}</button></view></view>
  </block>
  <view wx:if="{{screen === 'form'}}" class="card">
    <view class="heading">{{formTitle}}</view><text wx:if="{{source !== 'server'}}" class="notice">{{ui['当前是独立合成演示，请勿录入真实客户、签名或文件。'] || '当前是独立合成演示，请勿录入真实客户、签名或文件。'}}</text>
    <view wx:for="{{fields}}" wx:key="key" class="field"><text class="label">{{item.label}}{{item.required ? ' *' : ''}}</text>
      <picker wx:if="{{item.type === 'select'}}" range="{{item.options}}" range-key="label" value="{{item.index}}" disabled="{{busy || pending}}" bindchange="field" data-key="{{item.key}}"><view class="pick">{{item.options[item.index].label}} ›</view></picker>
      <switch wx:elif="{{item.type === 'bool'}}" checked="{{item.value}}" bindchange="field" data-key="{{item.key}}" color="#0F5144"/>
      <textarea wx:elif="{{item.type === 'textarea'}}" value="{{item.value}}" disabled="{{busy || pending}}" bindinput="field" data-key="{{item.key}}" maxlength="10000" auto-height placeholder="{{ui['请输入内容'] || '请输入内容'}}"/>
      <view wx:elif="{{item.type === 'signature'}}"><canvas canvas-id="signature" id="signature" class="signature" disable-scroll bindtouchstart="signatureStart" bindtouchmove="signatureMove" bindtouchend="signatureEnd"/><button size="mini" bindtap="clearSignature">{{ui['清空签名'] || '清空签名'}}</button></view>
      <view wx:elif="{{item.type === 'file'}}"><button bindtap="chooseFile">{{ui['从微信会话选择文件（≤6MB）'] || '从微信会话选择文件（≤6MB）'}}</button><text>{{fileLabel}}</text></view>
      <input wx:else value="{{item.value}}" bindinput="field" data-key="{{item.key}}" type="{{item.type === 'int' ? 'number' : item.type === 'money' ? 'digit' : 'text'}}" placeholder="{{item.type === 'datetime' ? '2026-11-03T10:00:00+08:00' : (ui['请输入内容'] || '请输入内容')}}"/>
    </view>
    <text wx:if="{{error}}" class="notice">{{error}}</text><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{ui['确认提交'] || '确认提交'}}</button><button bindtap="cancelForm" disabled="{{busy}}">{{ui['取消'] || '取消'}}</button>
  </view>
  <view wx:if="{{screen === 'settings'}}" class="card"><text class="label">{{ui['语言'] || '语言'}}</text><picker range="{{languages}}" range-key="name" value="{{languageIndex}}" bindchange="languageChange"><view class="pick">{{languages[languageIndex].name}}</view></picker><text class="label">{{ui['外观'] || '外观'}}</text><picker range="{{appearanceNames}}" bindchange="appearanceChange"><view class="pick">{{appearance === 'dark' ? appearanceNames[2] : appearance === 'light' ? appearanceNames[1] : appearanceNames[0]}}</view></picker><view class="heading">{{ui['服务器与我的'] || '服务器与我的'}}</view><text>{{actor.displayName || actor.name || username}}</text><text class="label">{{ui['服务器根地址'] || '服务器根地址'}}</text><input value="{{base}}" bindinput="input" data-key="base" placeholder="{{ui['https://维修服务域名'] || 'https://维修服务域名'}}"/><text class="label">{{ui['超时（500—10000 毫秒）'] || '超时（500—10000 毫秒）'}}</text><input type="number" value="{{timeout}}" bindinput="input" data-key="timeout"/><button bindtap="saveConfig" disabled="{{busy}}">{{ui['保存并重新登录'] || '保存并重新登录'}}</button>
    <text class="muted">{{ui['保存配置会清除当前身份资料。电脑工具本地调试可用回环 HTTP；手机与发布须使用有效 HTTPS 和小程序合法域名。微信登录、微信支付、订阅消息及认证电子签尚未接入。'] || '保存配置会清除当前身份资料。电脑工具本地调试可用回环 HTTP；手机与发布须使用有效 HTTPS 和小程序合法域名。微信登录、微信支付、订阅消息及认证电子签尚未接入。'}}</text><button wx:if="{{loggedIn}}" bindtap="logout" disabled="{{busy}}">{{ui['退出并清除会话'] || '退出并清除会话'}}</button><button wx:else bindtap="nav" data-screen="login">{{ui['返回登录'] || '返回登录'}}</button>
  </view>
</view>
