        "background.secondary": "#F2F2F7",
        "background.tertiary": "#FFFFFF",
        "background.grouped": "#F2F2F7",
        "background.grouped.secondary": "#FFFFFF",
        "background.grouped.tertiary": "#F2F2F7",
        "text.primary": "#000000",
        "text.secondary": "#595961",
        "text.tertiary": "#616169",
        "text.quaternary": "#62626A",
        "text.placeholder": "#62626A"
      },
      "images": {
