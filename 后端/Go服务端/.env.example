APP_ADDR=127.0.0.1:8080
ADMIN_WEB_DIR=../管理后台页面
WEB_DIR=../../前端/Web网页/旧版用户网页
DEMO_MODE=true
ALLOW_DEMO_NETWORK=false
SEED_DEMO_DATA=true
ALLOW_ANONYMOUS_DEMO=true
WORKER_ASSET_DIR=./private-uploads
SESSION_TTL_HOURS=24
# 首次创建管理员才填写；不提交实际凭据，不会覆盖已经存在的管理员密码。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# TiDB is MySQL-compatible. Leave TIDB_DSN empty to use the in-memory demo repository.
# Copy the connection string from TiDB Cloud or your TiDB deployment.
TIDB_DSN=
