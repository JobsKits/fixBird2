    {
      "id": "B01",
      "priority": 2,
      "title": "新建工单可写入不存在、未验收或跨企业的返修原单引用",
      "confirmed": true,
      "files": [
        {
          "path": "Server/internal/workbench/actions.go",
          "start": 185,
          "end": 227
        }
      ],
      "actual": "POST /api/v38/orders 将 originalOrderId 直接写入新工单，不查原单存在性、客户/企业或有效验收。customer-b 可把自己企业的新单关联到 company-a 的 wo_ready，并获得 201；随机不存在 ID 及本方未验收 wo_quote 也会持久化。",
      "expected": "返修原单引用至少应指向可授权、存在且有效验收的真实原单；普通新建不能绕过专用 rework 的关系完整性条件。",
      "impact": "可污染返修历史、跨企业关系与后续统计；原单详情仍被正确拒绝，本轮未观察到原单内容读取越权。",
      "requirement": "需求/物业设备维修服务平台 PRD V3.8（Jobs规范版）.md:461、1092、1798；专用 rework 目前在 actions.go:949-956 先校验有效验收。",
      "cases": [
        "TestR5BackendReworkReferenceGuards/missing_parent",
        "TestR5BackendReworkReferenceGuards/foreign_company_parent",
        "TestR5BackendReworkReferenceGuards/own_unaccepted_parent"
      ],
      "controls": [
        "ordinary_no_reference",
        "foreign_parent_itself_remains_unreadable",
        "direct_rework_requires_acceptance",
        "direct_rework_requires_company_role"
      ],
      "classification": "本轮新增发现的关系完整性缺陷，非已证实数据泄露。"
    },
